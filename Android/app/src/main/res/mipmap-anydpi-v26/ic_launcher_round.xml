<?xml version="1.0" encoding="utf-8"?>
<!-- The same icon as `ic_launcher`. Android 8 replaced the separate round bitmap
     with the mask, so declaring both keeps a launcher that asks for a round icon
     from falling back to the square one and having it shrunk inside a circle. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@android:color/black" />
    <foreground android:drawable="@mipmap/ic_launcher_foreground" />
</adaptive-icon>
