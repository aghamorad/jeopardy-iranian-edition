# macOS
.DS_Store
._*

# Claude Code local config (absolute paths, per-machine permissions)
.claude/

# Swift Package Manager build output
.build/
.swiftpm/
*.xcodeproj

# Build output and release bundles
dist/
*.app/
.production-backups/

# Source corpus — ~60 copyrighted books, not redistributable, several near GitHub's 100 MB file limit
Sources/

# Syllabus source material is local-only. The game may use it during authoring,
# but no format from these folders belongs in GitHub or downloadable packages.
**/Syllabus/

# The course overlay — Course/ — IS tracked. The banks, BANK_SPEC.md, the build tooling,
# the editions and the professor's art all belong in the repo. Only two things under it
# stay out, and the reason is copyright, not confidentiality: the source corpus
# (Sources/, above) and the course-marked syllabus material (**/Syllabus/, above).
# Students reading the questions off GitHub was never a problem. (Corrected 2026-09-14 —
# this entry used to ignore Course/ whole, which was the opposite of the rule.)

# Runtime caches
AudioCache/
__pycache__/

# Candidate renders from Tools/generate_image.sh. Authoring by-products, not
# product: the one that ships is copied into Web/assets/ under its own name and
# the rest are rejects kept only in case the choice is revisited. Same reason the
# source corpus and the build output are kept out.
Assets/Generated/

# Pre-pass backups. A tool that rewrites a bank in place writes `<file>.pre-<pass>`
# beside it first — `Tools/normalize_fa_prose.py` made eighteen of these on the
# calendar pass. They stay on disk, because that is the way back if a pass turns
# out to be wrong, but not in history: once the pass itself is committed git holds
# the same two states and the copies are only weight.
*.pre-*

# Scratch
Terminal Saved Output.txt
